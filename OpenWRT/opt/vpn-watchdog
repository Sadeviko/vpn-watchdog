#!/bin/sh

DIR_RUN="/opt/vpn-watchdog"
DIR_WORK="/var/run/vpn-watchdog"
CONFIG_FILE="${DIR_RUN}/config.conf"
FILE_SOURCE="${DIR_WORK}/source.txt"
FILE_FAVORITES="${DIR_WORK}/favorites.txt"
FILE_LOCK="${DIR_WORK}/vpn-watchdog.lock"
FILE_XRAY_CONF="${DIR_WORK}/xray-config.json"
PATH_XRAY_BIN="${DIR_RUN}/bin/xray_softfloat"
URL_SOURCE="https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/refs/heads/main/BLACK_VLESS_RUS.txt"
URL_TEST="http://www.google.com"
BLACKLIST_WORD=""
COUNTRY_EXCLUDE=""

mkdir -p "${DIR_RUN}/bin" "$DIR_WORK"

[ -s "$CONFIG_FILE" ] && . "$CONFIG_FILE"

json_escape() {
    printf '%s' "$1" | sed 's~\\~\\\\~g; s~"~\\"~g'
}

decode_param() {
    printf '%s' "$1" | sed \
        -e 's/+/ /g' \
        -e 's/%21/!/g; s/%22/"/g; s/%23/#/g; s/%24/$/g' \
        -e 's/%25/%/g; s/%26/\&/g; s/%27/'\''/g; s/%28/(/g' \
        -e 's/%29/)/g; s/%2A/*/g; s/%2B/+/g; s/%2C/,/g' \
        -e 's/%2D/-/g; s/%2E/./g; s/%2F/\//g' \
        -e 's/%3A/:/g; s/%3B/;/g; s/%3C/</g; s/%3D/=/g' \
        -e 's/%3E/>/g; s/%3F/?/g; s/%40/@/g' \
        -e 's/%5B/[/g; s/%5C/\\/g; s/%5D/]/g; s/%5E/^/g' \
        -e 's/%5F/_/g; s/%60/`/g' \
        -e 's/%7B/{/g; s/%7C/|/g; s/%7D/}/g; s/%7E/~/g'
}

generate_config() {
    local raw="$1"

    UID="" ADDRESS="" PORT="" SECURITY="" TYPE="" COUNTRY="" LINK=""

    local allowinsecure="" fp="" pbk="" sid="" sni="" spx=""
    local alpn="" authority="" flow="" headertype="" host="" mode="" path="" servicename=""
    local packet_encoding=""
    local protocol="" reference="" fragment="" parameters="" addrport=""
    local encryption="" transport="" outbound=""
    local OLD_IFS="" key="" val=""
    local users="" streamSettings="" tlsSettings=""

    case "$raw" in vless://*|hysteria2://*) ;; *) return 1 ;; esac

    protocol="${raw%%://*}"
    reference="${raw#*://}"; reference="${reference%%\#*}"
    fragment="${raw#*\#}"; [ "$fragment" = "$raw" ] && fragment=""
    parameters="${reference#*\?}"; [ "$parameters" = "$reference" ] && parameters=""
    addrport="${reference#*@}"; addrport="${addrport%%\?*}"; addrport="${addrport%%/*}"
    ADDRESS="${addrport%%:*}"; PORT="${addrport#*:}"; UID=$(decode_param "${reference%%@*}")

    if [ -n "$parameters" ]; then
        OLD_IFS="$IFS" IFS="&"
        for param in $parameters; do
            key="${param%%=*}"; val="${param#*=}"
            key=$(echo "$key" | tr 'A-Z' 'a-z')
            case "$key" in
                allowinsecure|insecure) [ "$(decode_param "$val")" = "0" ] || [ "$(decode_param "$val")" = "false" ] && allowinsecure="false" ;;
                fp) fp="$val" ;;
                pbk) pbk=$(json_escape "$(decode_param "$val")") ;;
                security) SECURITY="$val" ;;
                sid) sid=$(json_escape "$(decode_param "$val")") ;;
                sni) sni=$(json_escape "$(decode_param "$val")") ;;
                spx) spx=$(json_escape "$(decode_param "$val")") ;;
                alpn) alpn=$(decode_param "$val" | tr 'A-Z' 'a-z' | grep -oE 'h2|h3|http/1\.1' | tr '\n' ',' | sed 's/,$//') ;;
                authority) authority=$(json_escape "$(decode_param "$val")") ;;
                flow) flow="$val" ;;
                headertype) headertype="$val" ;;
                host) host=$(json_escape "$(decode_param "$val")") ;;
                mode) mode="$val" ;;
                path) path=$(json_escape "$(decode_param "$val")") ;;
                servicename) servicename=$(json_escape "$(decode_param "$val")") ;;
                type) TYPE="$val" ;;
                packetencoding) packet_encoding="$val" ;;
            esac
        done
        IFS="$OLD_IFS"
    fi

    [ -n "$UID" ] || return 1
    [ -n "$ADDRESS" ] || return 1
    [ "$PORT" = "$addrport" ] && PORT="443"

    if [ "$protocol" = "vless" ]; then
        [ "$TYPE" = "raw" ] && TYPE="tcp"
        [ "$SECURITY" != "tls" ] && [ "$SECURITY" != "reality" ] && SECURITY="none"
        [ "$SECURITY" = "reality" ] && { [ -n "$pbk" ] && [ -n "$sid" ] || return 1; }
        case " tcp ws grpc xhttp " in *" $TYPE "*) ;; *) return 1 ;; esac
    fi

    [ "$protocol" = "hysteria2" ] && SECURITY="tls" && TYPE="hysteria"

    COUNTRY=$(printf '%s' "$fragment" | sed 's/%7C/|/g; s/%[0-9A-F][0-9A-F]//g; s/%20/ /g; s/%2C/,/g' | sed 's/|.*//; s/[^a-zA-Z, ]//g; s/^[ ]*//; s/[ ]*$//')
    [ -z "$COUNTRY" ] && COUNTRY="NotSpecified"

    LINK="${protocol}://${reference}#${COUNTRY}"

    [ -n "$alpn" ] && alpn=$(echo "$alpn" | sed 's/[^,]\+/"&"/g; s/^/[/;s/$/]/')

    case "$protocol" in
        vless)
            users="\"id\": \"$UID\", \"encryption\": \"none\""
            [ -n "$flow" ] && [ "$TYPE" = "tcp" ] && users="$users, \"flow\": \"$flow\""

            case "$SECURITY" in
                reality)
                    [ -z "$sni" ] && sni="$ADDRESS"
                    encryption="\"realitySettings\": {"
                    [ -n "$fp" ] && encryption="${encryption} \"fingerprint\": \"${fp:-chrome}\","
                    encryption="${encryption} \"serverName\": \"$sni\", \"publicKey\": \"$pbk\", \"shortId\": \"$sid\""
                    [ -n "$spx" ] && encryption="${encryption}, \"spiderX\": \"$spx\""
                    encryption="${encryption} }"
                    ;;
                tls)
                    encryption="\"tlsSettings\": {"
                    [ -n "$fp" ] && encryption="${encryption} \"fingerprint\": \"${fp:-chrome}\","
                    [ -n "$sni" ] && encryption="${encryption} \"serverName\": \"$sni\","
                    [ -n "$allowinsecure" ] && encryption="${encryption} \"allowInsecure\": $allowinsecure,"
                    [ -n "$alpn" ] && encryption="${encryption} \"alpn\": $alpn,"
                    encryption="${encryption%,} }"
                    ;;
            esac

            case "$TYPE" in
                ws)
                    transport="\"wsSettings\": { \"path\": \"${path:-/}\", \"headers\": { \"Host\": \"${host:-${sni:-$ADDRESS}}\" }"
                    [ -n "$packet_encoding" ] && transport="${transport}, \"packetEncoding\": \"$packet_encoding\""
                    transport="${transport} }"
                    ;;
                grpc)
                    transport="\"grpcSettings\": { \"serviceName\": \"${servicename:-grpc}\""
                    [ -n "$authority" ] && transport="${transport}, \"authority\": \"$authority\""
                    [ "$mode" = "gun" ] && transport="${transport}, \"multiMode\": true"
                    transport="${transport} }"
                    ;;
                xhttp)
                    transport="\"xhttpSettings\": { \"path\": \"${path:-/}\""
                    [ -n "$host" ] && transport="${transport}, \"host\": \"$host\""
                    [ -n "$mode" ] && transport="${transport}, \"mode\": \"$mode\""
                    transport="${transport} }"
                    ;;
                *)
                    [ -n "$headertype" ] && [ "$headertype" != "none" ] && transport="\"tcpSettings\": { \"header\": { \"type\": \"$headertype\" } }"
                    ;;
            esac

            streamSettings="\"network\": \"$TYPE\", \"security\": \"$SECURITY\", \"sockopt\": { \"mark\": 255 }"
            [ -n "$encryption" ] && streamSettings="${streamSettings}, $encryption"
            [ -n "$transport" ] && streamSettings="${streamSettings}, $transport"

            outbound="{
    \"mux\": { \"enabled\": false },
    \"protocol\": \"vless\",
    \"settings\": { \"vnext\": [ { \"address\": \"$ADDRESS\", \"port\": $PORT, \"users\": [ { $users } ] } ] },
    \"streamSettings\": { $streamSettings }
}"
            ;;

        hysteria2)
            [ -z "$sni" ] && sni="$ADDRESS"
            tlsSettings="\"serverName\": \"$sni\""
            [ -n "$allowinsecure" ] && tlsSettings="${tlsSettings}, \"allowInsecure\": $allowinsecure"
            [ -n "$alpn" ] && tlsSettings="${tlsSettings}, \"alpn\": $alpn"

            outbound="{
    \"protocol\": \"hysteria\",
    \"settings\": { \"address\": \"$ADDRESS\", \"port\": $PORT, \"version\": 2 },
    \"streamSettings\": { \"network\": \"$TYPE\", \"security\": \"$SECURITY\", \"sockopt\": { \"mark\": 255 }, \"hysteriaSettings\": { \"auth\": \"$UID\", \"version\": 2 }, \"tlsSettings\": { $tlsSettings } }
}"
            ;;
    esac

    cat << JSON
{
    "dns": {
        "servers": ["8.8.8.8", "1.1.1.1"]
    },
    "log": {
        "loglevel": "none"
    },
    "inbounds": [
        {
            "listen": "0.0.0.0",
            "port": 8010,
            "protocol": "socks",
            "settings": { "udp": true },
            "sniffing": { "enabled": true, "destOverride": ["http", "tls", "quic"] }
        },
        {
            "listen": "0.0.0.0",
            "port": 54321,
            "protocol": "dokodemo-door",
            "settings": { "network": "tcp,udp", "followRedirect": true },
            "streamSettings": { "sockopt": { "tproxy": "tproxy" } }
        }
    ],
    "outbounds": [
        $outbound
    ]
}
JSON
}

update_source() {
    echo "Info: Trying to download source file..."
    if curl -ksSL --connect-timeout 7 -m 9 "$URL_SOURCE" > "$FILE_SOURCE"; then
        echo "Info: Source file updated, contains $(grep -cE '^(vless|hysteria2)://' "$FILE_SOURCE" 2>/dev/null || echo "0") lines."
        return 0
    else
        echo "Error: Failed to download source file!"
        return 1
    fi
}

start_xray() {
    killall "${PATH_XRAY_BIN##*/}" 2>/dev/null

    for i in 1 2 3 4 5 6 7 8 9; do
        netstat -an 2>/dev/null | grep -q ":8010.*LISTEN" || netstat -an 2>/dev/null | grep -q ":54321.*LISTEN" || break
        sleep 1
    done

    $PATH_XRAY_BIN run -c "$1" >/dev/null 2>&1 &

    for i in 1 2 3 4 5 6 7 8 9; do
        netstat -an 2>/dev/null | grep -q ":8010.*LISTEN" && netstat -an 2>/dev/null | grep -q ":54321.*LISTEN" && return 0
        sleep 1
    done
    return 1
}

check_connection() {
    local result code timing
    result=$(curl -x socks5h://127.0.0.1:8010 -s --connect-timeout 2 -m 3 -o /dev/null -w "%{http_code} %{time_total}" "$URL_TEST")
    code="${result%% *}"
    timing="${result##* }"

    echo "$code|$timing|$LINK" >> "${DIR_WORK}/debug.log"

    { [ "$code" = "200" ] || [ "$code" = "301" ] || [ "$code" = "302" ]; } && [ "${timing%.*}" -lt 3 ] && TIMING_CHECK=$(printf "%.3f" "$timing") || return 1
}

build_favorites() {
    if [ -f "$FILE_LOCK" ] || [ ! -s "$FILE_SOURCE" ]; then
        [ -f "$FILE_LOCK" ] && echo "Warning: Another instance is running (lock file exists)."
        [ -f "$FILE_LOCK" ] || echo "Warning: Source file not found. Use 'vless-watchdog update'."
        exit 1
    fi

    trap 'killall "${PATH_XRAY_BIN##*/}" 2>/dev/null; rm -f "$FILE_LOCK"' EXIT INT TERM
    touch "$FILE_LOCK"

    > "${DIR_WORK}/debug.log"

    local tmp_favorites="${DIR_WORK}/favorites.tmp"
    > "$tmp_favorites"
    > "$FILE_FAVORITES"

    local count=0 active=0
    local total=$(grep -cE '^(vless|hysteria2)://' "$FILE_SOURCE" 2>/dev/null || echo "0")
    local start_build=$(date +%s)

    while IFS= read -r line || [ -n "$line" ]; do
        [ -z "$line" ] && continue

        generate_config "$line" > "${FILE_XRAY_CONF%.json}.tmp.json" || continue

        [ -n "$BLACKLIST_WORD" ] && echo "$line" | grep -qiE "$BLACKLIST_WORD" && continue
        [ -n "$COUNTRY_EXCLUDE" ] && echo "$COUNTRY" | grep -qiE "$COUNTRY_EXCLUDE" && continue

        count=$((count + 1))
        printf "\r Processing: [$count/$total] ⏳"

        if start_xray "${FILE_XRAY_CONF%.json}.tmp.json"; then
            if check_connection; then
                echo "${TIMING_CHECK}|${LINK}" >> "$tmp_favorites"
                active=$((active + 1))
            fi
        fi
    done < "$FILE_SOURCE"

    local end_build=$(date +%s)
    printf "\r Processing: [$count/$total] ✅\n"
    killall "${PATH_XRAY_BIN##*/}" 2>/dev/null

    if [ -s "$tmp_favorites" ]; then
        sort -t'|' -k1 -n "$tmp_favorites" | awk -F'|' '
        {
            match($2, /@([^:?]+)/); addr = substr($2, RSTART+1, RLENGTH-1)
            match($2, /:\/\/([^@]+)/); uid = substr($2, RSTART+3, RLENGTH-3)
            if (!addr || !uid) next

            if (!seen_a[addr]++) {
                if (!seen_u[uid]++) {
                    # Приоритет 1: уникальные IP + уникальные UID
                    print $2
                    count++
                } else {
                    # Буфер: уникальные IP + общий UID
                    backup[++bcount] = $2
                }
            }
        }
        END {
            if (count < 15) {
                for (i = 1; i <= bcount && count < 15; i++) {
                    print backup[i]
                    count++
                }
            }
        }' | head -15 > "$FILE_FAVORITES"
    fi

    echo "=====FAVORITES====="

    if [ -s "$FILE_FAVORITES" ]; then
        local timing
        while IFS= read -r link; do
            timing=$(grep -F "|${link}" "$tmp_favorites" | cut -d'|' -f1 | head -1)
            generate_config "$link" > /dev/null
            printf " %-7s | %-15s | %-25.25s | %-35.35s\n" "${timing}s" "[$SECURITY/$TYPE]" "$COUNTRY" "$ADDRESS:$PORT"
        done < "$FILE_FAVORITES"
        echo "==================="
        echo " Actives: $active | Time: $((end_build - start_build))s"
    else
        echo "Error: No active servers found!"
    fi

    rm -f "${FILE_XRAY_CONF%.json}.tmp.json" "$FILE_LOCK"
}

switch_next() {
    if [ -f "$FILE_LOCK" ] || [ ! -s "$FILE_FAVORITES" ]; then
        [ -f "$FILE_LOCK" ] && echo "Warning: Another instance is running (lock file exists)."
        [ -f "$FILE_LOCK" ] || echo "Warning: Favorites file not found. Use 'vless-watchdog build'."
        exit 1
    fi

    trap 'killall "${PATH_XRAY_BIN##*/}" 2>/dev/null; rm -f "$FILE_LOCK"' EXIT INT TERM
    touch "$FILE_LOCK"

    local current_address=""
    [ -f "$FILE_XRAY_CONF" ] && current_address=$(jsonfilter -e '@.outbounds[0]..address' < "$FILE_XRAY_CONF" 2>/dev/null)

    local first="" found=0 next=""

    while IFS= read -r line || [ -n "$line" ]; do
        [ -z "$line" ] && continue
        [ -z "$first" ] && first="$line"

        generate_config "$line" > /dev/null || continue

        if [ "$found" -eq 1 ] && [ "$ADDRESS" != "$current_address" ]; then
            next="$line"
            break
        fi
        [ "$ADDRESS" = "$current_address" ] && found=1
    done < "$FILE_FAVORITES"

    [ -z "$next" ] && next="$first"

    generate_config "$next" > "$FILE_XRAY_CONF" || exit 1

    if start_xray "$FILE_XRAY_CONF"; then
        if check_connection; then
            echo "Info: Switched to next server: $ADDRESS:$PORT"
            rm -f "$FILE_LOCK"
            exit 0
        fi
    fi

    echo "Warning: This server is unavailable, please switch to another one."
    rm -f "$FILE_LOCK"
    exit 1
}

main() {
    if [ -f "$FILE_LOCK" ]; then
        echo "Warning: Another instance is running (lock file exists)."
        exit 1
    fi

    trap 'killall "${PATH_XRAY_BIN##*/}" 2>/dev/null; rm -f "$FILE_LOCK"' EXIT INT TERM
    touch "$FILE_LOCK"

    if [ -f "$FILE_XRAY_CONF" ] && check_connection; then
        local current_address=$(jsonfilter -e '@.outbounds[0]..address' < "$FILE_XRAY_CONF" 2>/dev/null)
        if [ -n "$current_address" ] && grep -q "$current_address" "$FILE_FAVORITES" 2>/dev/null; then
            echo "Info: The connection works!"
            rm -f "$FILE_LOCK"
            exit 0
        fi
    fi

    if [ -s "$FILE_FAVORITES" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            [ -z "$line" ] && continue
            
            generate_config "$line" > "$FILE_XRAY_CONF" || continue
            
            if start_xray "$FILE_XRAY_CONF" && check_connection; then
                echo "Info: Connection established, current server $ADDRESS:$PORT."
                rm -f "$FILE_LOCK"
                exit 0
            fi
        done < "$FILE_FAVORITES"
    fi

    rm -f "$FILE_LOCK"

    echo "Warning: No available servers found, trying to rebuild the favorites list..."
    build_favorites

    if [ ! -s "$FILE_FAVORITES" ]; then
        echo "Error: No active servers found in source file. Use 'vless-watchdog update'."
        exit 1
    else
        echo "Info: Favorites list rebuilt successfully. Use 'vless-watchdog main'."
        exit 0
    fi
}

case "$1" in
    update) update_source ;;
    build) build_favorites ;;
    next) switch_next ;;
    main) main ;;
    all) update_source && build_favorites && main ;;
    *) echo "Usage: $0 {update|build|next|main|all}"; exit 1 ;;
esac
